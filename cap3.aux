\newlabel{III:Caminatas_ev}{{3.3}{46}{Evolución de los tipos de caminata}{section.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces En la primer figura se muestra la evolución mensual de los tres tipos de caminata a lo largo del año, mientras que en la segunda figura se muestra el promedio de los mismos separados por período de actividad reproductiva: Reprododucción (Noviembre a Enero), Puesta de Huevo (Febrero a Marzo) y Brumación (Abril a Octubre). Los valores son el promedio entre individuos (n$=5$), y las barras corresponden a la desviación estándar entre ellos.}}{47}{figure.caption.55}\protected@file@percent }
\newlabel{fig:ev_comportamiento}{{3.4}{47}{En la primer figura se muestra la evolución mensual de los tres tipos de caminata a lo largo del año, mientras que en la segunda figura se muestra el promedio de los mismos separados por período de actividad reproductiva: Reprododucción (Noviembre a Enero), Puesta de Huevo (Febrero a Marzo) y Brumación (Abril a Octubre). Los valores son el promedio entre individuos (n$=5$), y las barras corresponden a la desviación estándar entre ellos}{figure.caption.55}{}}
