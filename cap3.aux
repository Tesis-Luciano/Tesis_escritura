\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Criterios para ubicar el refugio. (a) Ventanas horarias: la nocturna estándar ($n=0$, 20--6 h), sus ensanchamientos ($n=1,2,3$) y la ventana diurna de 9 a 17 h, sobre el histograma de la cantidad de mediciones por hora. (b) Ejemplos reales de la tortuga T54, con las posiciones respecto del centroide (``+'') y un círculo de referencia de $10\,\mathrm  {m}$: una noche aceptada con la ventana estándar, una aceptada al ensanchar, una rechazada ($\sigma \geq 10\,\mathrm  {m}$ para todo $n\leq 3$) y una aceptada con la alternativa diurna.}}{28}{figure.caption.34}\protected@file@percent }
\newlabel{fig:criterios_refugio}{{3.1}{28}{Criterios para ubicar el refugio. (a) Ventanas horarias: la nocturna estándar ($n=0$, 20--6 h), sus ensanchamientos ($n=1,2,3$) y la ventana diurna de 9 a 17 h, sobre el histograma de la cantidad de mediciones por hora. (b) Ejemplos reales de la tortuga T54, con las posiciones respecto del centroide (``+'') y un círculo de referencia de $10\,\mathrm {m}$: una noche aceptada con la ventana estándar, una aceptada al ensanchar, una rechazada ($\sigma \geq 10\,\mathrm {m}$ para todo $n\leq 3$) y una aceptada con la alternativa diurna}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces En la primer figura se muestra la evolución mensual de los tres tipos de caminata a lo largo del año, mientras que en la segunda figura se muestra el promedio de los mismos separados por período de actividad reproductiva: Reprododucción (Noviembre a Enero), Puesta de Huevo (Febrero a Marzo) y Brumación (Abril a Octubre). Los valores son el promedio entre individuos (n$=5$), y las barras corresponden a la desviación estándar entre ellos.}}{29}{figure.caption.35}\protected@file@percent }
\newlabel{fig:ev_comportamiento}{{3.2}{29}{En la primer figura se muestra la evolución mensual de los tres tipos de caminata a lo largo del año, mientras que en la segunda figura se muestra el promedio de los mismos separados por período de actividad reproductiva: Reprododucción (Noviembre a Enero), Puesta de Huevo (Febrero a Marzo) y Brumación (Abril a Octubre). Los valores son el promedio entre individuos (n$=5$), y las barras corresponden a la desviación estándar entre ellos}{figure.caption.35}{}}
