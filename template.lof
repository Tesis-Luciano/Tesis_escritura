\contentsline {figure}{\numberline {2.6}{\ignorespaces MSD para el segundo modelo, con tiempo constante de reposo.}}{17}{figure.caption.27}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Distribución de desplazamientos a 15 minutos para el tercer modelo, con $\sigma _\theta = 0.2$, $\alpha _W = 1.75$ y distintos valores de $\alpha _S$.}}{18}{figure.caption.29}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Distribución de desplazamientos a 15 minutos para $\sigma _\theta = 0.5$, $\alpha _S = 0.75$ y $\alpha _W = 1.6$ y $1.75$.}}{19}{figure.caption.30}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces MSD para $\sigma _\theta = 0.5$, $\alpha _S = 0.75$ y $\alpha _W = 1.6$ y $1.75$. La línea gris indica el comportamiento difusivo.}}{19}{figure.caption.31}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Criterios para ubicar el refugio. (a) Ventanas horarias: la nocturna estándar ($n=0$, 20--6 h), sus ensanchamientos ($n=1,2,3$) y la ventana diurna de 9 a 17 h, sobre el histograma de la cantidad de mediciones por hora. (b) Ejemplos reales de la tortuga T54, con las posiciones respecto del centroide (``+'') y un círculo de referencia de $10\,\mathrm {m}$: una noche aceptada con la ventana estándar, una aceptada al ensanchar, una rechazada ($\sigma \geq 10\,\mathrm {m}$ para todo $n\leq 3$) y una aceptada con la alternativa diurna.}}{24}{figure.caption.33}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces En la primer figura se muestra la evolución mensual de los tres tipos de caminata a lo largo del año, mientras que en la segunda figura se muestra el promedio de los mismos separados por período de actividad reproductiva: Reprododucción (Noviembre a Enero), Puesta de Huevo (Febrero a Marzo) y Brumación (Abril a Octubre). Los valores son el promedio entre individuos (n$=5$), y las barras corresponden a la desviación estándar entre ellos.}}{25}{figure.caption.34}%
