\contentsline {figure}{\numberline {1.1}{\ignorespaces Distribución geográfica de la tortuga terrestre argentina, \textit {Chelonoidis chilensis}.}}{2}{figure.caption.13}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Dispositivo de navegación utilizado para la recolección de datos.}}{4}{figure.caption.14}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Ejemplo de distribuciones de tiempos que el individuo, en este caso la tortuga T405, pasa en cada uno de los estados de forma ininterrumpida \cite {callenbach2025}.}}{4}{figure.caption.15}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Imagen del dispositivo i-gotU, utilizado para la adquisición de datos espaciotemporales de las tortugas.}}{5}{figure.caption.16}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces La figura de la izquierda muestra la frecuencia de variación de posiciones de los ejes x e y con los datos en bines logarítmicos y ajustando distintas distribuciones, mientras que a la derecha se muestra la dependencia de la probabilidad de medir un desplazamiento d en 15 minutos tanto para los datos nocturnos como para las curvas ajustadas.}}{7}{figure.caption.18}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Desvío robusto por eje de la diferencia entre dos posiciones de una tortuga quieta, en función del tiempo que las separa, en noches (22--6 h) y en brumación profunda (mayo--agosto, 11--15:45 h). Barras: intervalo del 95\% por bootstrap sobre noches o días. Franjas: nivel de 30--60 min y de 90--240 min, calculado sobre las mismas noches o días, con su intervalo del 95\%. En brumación solo se muestran separaciones múltiplos de 30 min, el intervalo de registro en esos meses.}}{9}{figure.caption.19}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Criterios para ubicar el refugio. (a) Ventanas horarias: la nocturna estándar ($n=0$, 20--6 h), sus ensanchamientos ($n=1,2,3$) y la ventana diurna de 9 a 17 h, sobre el histograma de la cantidad de mediciones por hora. (b) Ejemplos reales de la tortuga T54, con las posiciones respecto del centroide (``+'') y un círculo de referencia de $10\,\mathrm {m}$: una noche aceptada con la ventana estándar, una aceptada al ensanchar, una rechazada ($\sigma _R\geq 10\,\mathrm {m}$ para todo $n\leq 3$) y una aceptada con la alternativa diurna.}}{12}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Esquema de un caminante aleatorio correlacionado. En cada paso, el individuo cambia su dirección de movimiento en un ángulo $\eta _i$ sorteado de una distribución gaussiana de media nula y desviación estándar $\sigma _\theta $.}}{17}{figure.caption.23}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Distribución de desplazamientos a 15 minutos para el tercer modelo, con $\sigma _\theta = 0.2$, $\alpha _W = 1.75$ y distintos valores de $\alpha _S$.}}{18}{figure.caption.24}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Distribución de desplazamientos a 15 minutos y MSD, para las mejores configuraciones, priorizando la primera métrica, la segunda o un compromiso entre ambas.}}{19}{figure.caption.25}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Desvío robusto por eje de la diferencia entre dos posiciones de una tortuga quieta, en función del tiempo que las separa, para noches (22--6 h) y brumación profunda (mayo--agosto, 11--15:45 h), junto con el modelo sin deriva (discontinuo) y con deriva (continuo).}}{21}{figure.caption.30}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Métricas de configuraciones en donde se maximiza la similitud a las curvas empíricas del P(d), del MSD o un compromiso entre ambas métricas.}}{22}{figure.caption.32}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Métricas de configuraciones en donde se maximiza la similitud a las curvas empíricas del P(d), del MSD o un compromiso entre ambas métricas.}}{23}{figure.caption.33}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Histograma de hora a la cual el individuo se aleja por primera vez a una distancia mayor a 10 metros en los datos, las mejores configuraciones del modelo previo (azul) y ajuste de una sigmoide a los datos.}}{24}{figure.caption.34}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Modelo con los mismos parámetros ($v = 2.5$~m/min, $\sigma _\theta = 0.07$, $\alpha _W = -1.8$, $\alpha _S = -1.55$), con y sin la capa de salida, frente a los datos de todo el año: P(d), MSD diario e histograma de la hora de salida, detectada en el modelo y en los datos con la regla del tercer fix.}}{26}{figure.caption.35}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Modelo base, agregando únicamente la variabilidad de la velocidad instantánea mientras camina. En línea azul se muestra la mejor configuración que intenta replicar los datos de ambas métricas.}}{27}{figure.caption.36}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Modelo con las capas de ruido de GPS, horario de salida y variabilidad en la velocidad. En línea naranja se muestra la mejor configuración que intenta replicar los datos de las métricas.}}{27}{figure.caption.37}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Métrica de hora en la que el modelo cruza el umbral de los 10 metros (naranja), respecto a la curva ajustada en la sección anterior (Sección~\ref {II:hr_comienzo}) y de los datos.}}{28}{figure.caption.38}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Trayectorias del día completo (6--22 h), relativas a la primera posición del día, en metros. La clasificación usa el desplazamiento entre las 8 y las 20 h y el refugio de la noche anterior y de la siguiente.}}{29}{figure.caption.39}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Distribución de desplazamientos cada 15 minutos, para los tres tipos de trayectorias.}}{31}{figure.caption.40}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces MSD para los tres tipos de trayectorias.}}{32}{figure.caption.41}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Ejemplos de trayectorias de los datos clasificados como de reposo en la parte superior, comparados con trayectorias simuladas presentes en la parte inferior. El círculo naranja, de $10\,\mathrm {m}$ de radio alrededor de la posición inicial, marca el umbral de la clasificación: si la mediana de 3 posiciones consecutivas lo supera, el día deja de clasificarse como de Reposo.}}{34}{figure.caption.42}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Análisis de las métricas de desplazamientos cada 15 minutos (a), el MSD diario (b) y la distancia máxima en el día (c). En estos gráficos comparamos los datos con errores independientes, correlacionados y correlacionados con deriva lenta.}}{34}{figure.caption.43}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Análisis de las métricas de desplazamientos cada 15 minutos (a) y el MSD diario (b), para la configuración que mejor ajusta los datos correspondientes a las trayectorias de cambio de refugio.}}{36}{figure.caption.45}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces Gráfico de la métrica de horario de salida del refugio para el modelo de cambio de refugio, en comparación con sus datos.}}{36}{figure.caption.46}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Análisis de la métrica de tiempo que tardan las caminatas de exploración y retorno en llegar desde que sale del refugio hasta la distancia máxima de la caminata.}}{37}{figure.caption.47}%
\contentsline {figure}{\numberline {2.20}{\ignorespaces Análisis de las métricas de desplazamientos cada 15 minutos, el MSD diario y la fracción de días con tiempo de exploración mayor al eje x, para la configuración que mejor ajusta los datos correspondientes a las trayectorias de Exploración y retorno.}}{38}{figure.caption.48}%
\contentsline {figure}{\numberline {2.21}{\ignorespaces Gráfico de la métrica de horario de salida del refugio para el modelo de exploración y retorno, en comparación con sus datos.}}{38}{figure.caption.49}%
\contentsline {figure}{\numberline {2.22}{\ignorespaces Métricas del modelo combinando los submodelos según los pesos de la Tabla~\ref {tab:Porcentajes_días}.}}{40}{figure.caption.51}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Registro de las posiciones medidas de GPS separadas por períodos asociados a distintos comportamientos reproductivos. Cada tortuga tiene un color, cuya intensidad que aumenta con el paso del tiempo. Las estrellas marcan las posiciones de los refugios donde pasaron la noche.}}{42}{figure.caption.52}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Registro de las posiciones medidas de GPS para el período de reproducción, montado sobre la imagen satelital del terreno, mostrando una utilización considerable de los bordes de las calles.}}{43}{figure.caption.53}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Radio de giro mensual de las posiciones de GPS de cada tortuga, entre febrero de 2022 y enero de 2023. Las barras negras corresponden al promedio de los machos (M) y de las hembras (H), y el fondo indica la época.}}{44}{figure.caption.54}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces En la primera figura se muestra la evolución mensual de los tres tipos de caminata a lo largo del año, mientras que en la segunda figura se muestra el promedio de los mismos separados por período de actividad reproductiva: Reproducción (noviembre a enero), Puesta de huevo (febrero a marzo) y Brumación (abril a octubre). Los valores son el promedio entre individuos (n$=5$), y las barras corresponden a la desviación estándar entre ellos.}}{45}{figure.caption.55}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Histograma de hora de salida del refugio según el tipo de caminata y el período del año.}}{46}{figure.caption.56}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Tasa de revisita de los refugios de cada tortuga dentro de cada época completa. Las barras negras corresponden al promedio de los machos (M) y de las hembras (H).}}{47}{figure.caption.57}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Probabilidad de revisita de un refugio en función de la frecuencia de visita previa del refugio.}}{48}{figure.caption.58}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Probabilidad de moverse a un refugio no explorado en función del número de refugios distintos explorados previamente.}}{48}{figure.caption.59}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Cantidad de refugios distintos visitados en función del número de eventos $n$, donde $n = 1$ corresponde al primer refugio observado. En gris, cada tortuga; en azul, el promedio de las seis. La línea punteada es el ajuste $\langle S(n) \rangle \sim n^{\mu }$.}}{49}{figure.caption.60}%
